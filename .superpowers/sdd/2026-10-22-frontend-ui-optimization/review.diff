+import { describe, expect, it } from "vitest";
+import { isQuotaError, lastUserMessage } from "./retry";
+
+describe("重试这一句", () => {
+  const file = { id: "f1", path: "uploads/a.xlsx", media_type: "application/x", size: 3 };
+
+  it("取最后一条用户消息，连同它带的文件", () => {
+    expect(
+      lastUserMessage({
+        running: false,
+        items: [
+          { kind: "user", id: "u1", text: "第一句" },
+          { kind: "assistant", id: "m1", text: "好" },
+          { kind: "user", id: "u2", text: "第二句", attachments: [file] },
+          { kind: "error", id: "e1", text: "模型网关不可用" },
+        ],
+      }),
+    ).toEqual({ text: "第二句", attachments: [file] });
+  });
+
+  it("没带文件时文件为空；还没有用户消息时没有", () => {
+    expect(
+      lastUserMessage({ running: false, items: [{ kind: "user", id: "u1", text: "嗨" }] }),
+    ).toEqual({ text: "嗨", attachments: [] });
+    expect(lastUserMessage({ running: false, items: [] })).toBeNull();
+  });
+});
+
+describe("额度用完", () => {
+  it("以“模型额度用完了”开头的才算：重试也没用，不给“重试这一句”", () => {
+    expect(isQuotaError("模型额度用完了（模型服务返回余额或配额不足）。")).toBe(true);
+    expect(isQuotaError("模型网关不可用")).toBe(false);
+  });
+});
