+import { describe, expect, it } from "vitest";
+import type { Thread } from "../../api/types";
+import { startNewChat } from "./newChat";
+
+const created = {
+  id: "t1",
+  model: "default-model",
+  permission_mode: "ask",
+} as Thread;
+
+function fakeDeps(options: { failRun?: boolean } = {}) {
+  const calls: string[] = [];
+  return {
+    calls,
+    deps: {
+      createThread: async () => {
+        calls.push("create");
+        return created;
+      },
+      updateThread: async (threadId: string, patch: Record<string, unknown>) => {
+        calls.push(`update ${threadId} ${JSON.stringify(patch)}`);
+        return { ...created, ...patch } as Thread;
+      },
+      startRun: async (threadId: string, text: string) => {
+        calls.push(`run ${threadId} ${text}`);
+        if (options.failRun) throw new Error("该会话已有进行中的运行");
+        return {};
+      },
+    },
+  };
+}
+
+describe("落地页发第一条消息", () => {
+  it("建会话 → 按所选改模型与权限 → 发消息", async () => {
+    const { calls, deps } = fakeDeps();
+    const result = await startNewChat({ text: "你好", model: "other", permission: "skip" }, deps);
+    expect(calls).toEqual([
+      "create",
+      'update t1 {"model":"other","permission_mode":"skip"}',
+      "run t1 你好",
+    ]);
+    // 返回改过设置的会话：放进会话列表时模型、权限就是对的
+    expect(result).toEqual({
+      thread: { ...created, model: "other", permission_mode: "skip" },
+      error: null,
+    });
+  });
+
+  it("模型与权限都和新会话一样：不改会话；只改不一样的那项", async () => {
+    const same = fakeDeps();
+    await startNewChat({ text: "你好", model: "default-model", permission: "ask" }, same.deps);
+    expect(same.calls).toEqual(["create", "run t1 你好"]);
+    const onlyPermission = fakeDeps();
+    await startNewChat(
+      { text: "你好", model: "default-model", permission: "ask_execute" },
+      onlyPermission.deps,
+    );
+    expect(onlyPermission.calls[1]).toBe('update t1 {"permission_mode":"ask_execute"}');
+  });
+
+  it("模型列表还没加载（没选模型）：用新会话的默认模型", async () => {
+    const { calls, deps } = fakeDeps();
+    await startNewChat({ text: "你好", model: "", permission: "ask" }, deps);
+    expect(calls).toEqual(["create", "run t1 你好"]);
+  });
+
+  it("会话建好了但消息没发出去：返回已建的会话与原因", async () => {
+    const { deps } = fakeDeps({ failRun: true });
+    const result = await startNewChat({ text: "你好", model: "", permission: "ask" }, deps);
