diff -ruN -x schema.d.ts -x openapi.json -x __pycache__ frontend/src/features/chat/newChat.ts frontend/src/features/chat/newChat.ts
--- frontend/src/features/chat/newChat.ts	1970-01-01 08:00:00
+++ frontend/src/features/chat/newChat.ts	2026-10-22 20:41:28
@@ -0,0 +1,36 @@
+import { readableError } from "../../api/client";
+import type { PermissionMode, Thread, ThreadUpdate } from "../../api/types";
+
+export interface NewChatDeps {
+  createThread: () => Promise<Thread>;
+  updateThread: (threadId: string, patch: ThreadUpdate) => Promise<Thread>;
+  startRun: (threadId: string, text: string) => Promise<unknown>;
+}
+
+/**
+ * 落地页发第一条消息（设计 2026-10-22 3.11）：发送时才建会话 → 模型或权限与新会话不同时才改 →
+ * 发消息。建会话失败时抛出（还没有会话，字留在落地页）；之后出错时返回已建的会话与原因，
+ * 由页面打开这个会话、显示原因并把字填回草稿。model 为空（模型列表还没加载）时用新会话的默认模型。
+ */
+export async function startNewChat(
+  input: { text: string; model: string; permission: PermissionMode },
+  deps: NewChatDeps,
+): Promise<{ thread: Thread; error: string | null }> {
+  const thread = await deps.createThread();
+  const patch: ThreadUpdate = {
+    ...(input.model && input.model !== thread.model ? { model: input.model } : {}),
+    ...(input.permission !== thread.permission_mode ? { permission_mode: input.permission } : {}),
+  };
+  let current = thread;
+  try {
+    if (Object.keys(patch).length > 0) current = await deps.updateThread(thread.id, patch);
+  } catch (error) {
+    return { thread: current, error: `改会话设置失败：${readableError(error)}` };
+  }
+  try {
+    await deps.startRun(current.id, input.text);
+  } catch (error) {
+    return { thread: current, error: `发送失败：${readableError(error)}` };
+  }
+  return { thread: current, error: null };
+}
