@@ -0,0 +1,15 @@
+import type { RunAttachment } from "../../api/types";
+import type { ChatState } from "./reducer";
+
+/** 最后一条用户消息与它带的文件（报错卡片的"重试这一句"把它原样再发一次）。 */
+export function lastUserMessage(
+  state: ChatState,
+): { text: string; attachments: RunAttachment[] } | null {
+  const item = state.items.findLast((entry) => entry.kind === "user");
+  return item?.kind === "user" ? { text: item.text, attachments: item.attachments ?? [] } : null;
+}
+
+/** 额度用完（后端的说法以"模型额度用完了"开头，D23）：重试也没用，不给"重试这一句"。 */
+export function isQuotaError(text: string): boolean {
+  return text.startsWith("模型额度用完了");
+}
