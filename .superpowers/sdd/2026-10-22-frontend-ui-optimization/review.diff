+import { describe, expect, it } from "vitest";
+import { parseExecuteOutput, summarizeTools, toolLabel } from "./tools";
+
+describe("工具的中文名与摘要", () => {
+  it.each([
+    ["execute", { command: "ls -la" }, "执行命令", "ls -la", "execute"],
+    ["read_file", { file_path: "/a.md" }, "读取文件", "/a.md", "read"],
+    ["write_file", { file_path: "/b.md" }, "写入文件", "/b.md", "write"],
+    ["edit_file", { file_path: "/c.md" }, "修改文件", "/c.md", "write"],
+    ["ls", { path: "/workspace" }, "列出目录", "/workspace", "find"],
+    ["glob", { pattern: "**/*.py" }, "查找文件", "**/*.py", "find"],
+    ["grep", { pattern: "TODO" }, "搜索文件内容", "TODO", "find"],
+    ["write_todos", { todos: [] }, "更新待办", "", "todos"],
+    ["search_knowledge", { query: "花生" }, "检索知识库", "花生", "knowledge"],
+    ["read_document", { item_id: "x" }, "读取文档", "", "knowledge"],
+    ["remember", { content: "用户对花生过敏" }, "记住", "用户对花生过敏", "memory"],
+  ] as const)("%s → %s", (name, args, verb, detail, kind) => {
+    expect(toolLabel(name, args)).toEqual({ verb, detail, kind });
+  });
+
+  it("MCP 服务的工具：外部工具 · 服务 · 工具", () => {
+    expect(toolLabel("files_write_file", { path: "/a" })).toEqual({
+      verb: "外部工具",
+      detail: "files · write_file",
+      kind: "external",
+    });
+  });
+
+  it("不认识的工具显示原名", () => {
+    expect(toolLabel("Mystery", {})).toEqual({ verb: "Mystery", detail: "", kind: "other" });
+  });
+
+  it("参数缺失或不是文字时摘要为空，不报错", () => {
+    expect(toolLabel("execute", {})).toEqual({ verb: "执行命令", detail: "", kind: "execute" });
+    expect(toolLabel("read_file", { file_path: 3 })).toMatchObject({ detail: "" });
+  });
+});
+
+describe("一组工具的摘要", () => {
+  it("按首次出现的顺序合计，用逗号连接", () => {
+    expect(summarizeTools(["read_file", "execute", "read_file"])).toBe(
+      "读取了 2 个文件，运行了 1 条命令",
+    );
+  });
+
+  it("各类工具的说法", () => {
+    expect(
+      summarizeTools([
+        "ls",
+        "grep",
+        "write_file",
+        "search_knowledge",
+        "remember",
+        "write_todos",
+        "files_list",
+        "Mystery",
+      ]),
+    ).toBe(
+      "查找了 2 次，改动了 1 个文件，检索了 1 次知识库，记下了 1 条记忆，更新了待办，" +
+        "调用了 1 次外部工具，调用了 1 个工具",
+    );
+  });
+});
+
+describe("执行命令的输出", () => {
+  it("去掉末尾的退出码那一行，取出退出码", () => {
+    expect(parseExecuteOutput("ok\n[Command succeeded with exit code 0]")).toEqual({
+      text: "ok",
+      exitCode: 0,
+    });
+    expect(parseExecuteOutput("boom\n[Command failed with exit code 2]")).toEqual({
+      text: "boom",
+      exitCode: 2,
+    });
+  });
+
+  it("截断说明保留", () => {
+    expect(
+      parseExecuteOutput(
+        "out\n[Command succeeded with exit code 0]\n[Output was truncated due to size limits]",
+      ),
+    ).toEqual({ text: "out\n[Output was truncated due to size limits]", exitCode: 0 });
+  });
+
+  it("没有输出、只有退出码", () => {
+    expect(parseExecuteOutput("[Command succeeded with exit code 0]")).toEqual({
+      text: "",
+      exitCode: 0,
+    });
+  });
+
+  it("旧记录没有退出码那一行：原文不变", () => {
+    expect(parseExecuteOutput("plain")).toEqual({ text: "plain", exitCode: null });
+  });
+});
diff -ruN -x schema.d.ts -x openapi.json -x __pycache__ frontend/src/components/chat/tools.ts frontend/src/components/chat/tools.ts
--- frontend/src/components/chat/tools.ts	1970-01-01 08:00:00
+++ frontend/src/components/chat/tools.ts	2026-10-22 20:20:16
@@ -0,0 +1,81 @@
+/** 工具的类别：决定图标与一组工具的合计说法。 */
+export type ToolKind =
+  "read" | "find" | "write" | "execute" | "knowledge" | "memory" | "todos" | "external" | "other";
+
+export interface ToolLabel {
+  verb: string;
+  /** 一段摘要：命令、文件路径、检索词等；没有时为空 */
+  detail: string;
+  kind: ToolKind;
+}
+
+// 内置工具：中文动词 + 取哪个参数做摘要（设计 2026-10-22 3.5）
+const BUILTIN: Record<string, { verb: string; arg: string | null; kind: ToolKind }> = {
+  execute: { verb: "执行命令", arg: "command", kind: "execute" },
+  read_file: { verb: "读取文件", arg: "file_path", kind: "read" },
+  write_file: { verb: "写入文件", arg: "file_path", kind: "write" },
+  edit_file: { verb: "修改文件", arg: "file_path", kind: "write" },
+  ls: { verb: "列出目录", arg: "path", kind: "find" },
+  glob: { verb: "查找文件", arg: "pattern", kind: "find" },
+  grep: { verb: "搜索文件内容", arg: "pattern", kind: "find" },
+  write_todos: { verb: "更新待办", arg: null, kind: "todos" },
+  search_knowledge: { verb: "检索知识库", arg: "query", kind: "knowledge" },
+  read_document: { verb: "读取文档", arg: null, kind: "knowledge" },
+  remember: { verb: "记住", arg: "content", kind: "memory" },
+};
+
+// MCP 服务的工具名是"服务名_工具名"（服务名只含小写字母、数字、连字符）
+const EXTERNAL = /^([a-z0-9-]+)_(.+)$/;
+
+/** 工具行的中文动词与摘要；MCP 工具显示"外部工具 · 服务 · 工具"，不认识的显示原名。 */
+export function toolLabel(name: string, args: Record<string, unknown>): ToolLabel {
+  const builtin = BUILTIN[name];
+  if (builtin) {
+    const value = builtin.arg ? args[builtin.arg] : undefined;
+    return {
+      verb: builtin.verb,
+      detail: typeof value === "string" ? value : "",
+      kind: builtin.kind,
+    };
+  }
+  const external = EXTERNAL.exec(name);
+  if (external) {
+    return { verb: "外部工具", detail: `${external[1]} · ${external[2]}`, kind: "external" };
+  }
+  return { verb: name, detail: "", kind: "other" };
+}
+
+// 一组工具的合计说法（"更新了待办"不计次数）
+const SUMMARY: Record<ToolKind, (count: number) => string> = {
+  read: (n) => `读取了 ${n} 个文件`,
+  find: (n) => `查找了 ${n} 次`,
+  write: (n) => `改动了 ${n} 个文件`,
+  execute: (n) => `运行了 ${n} 条命令`,
+  knowledge: (n) => `检索了 ${n} 次知识库`,
+  memory: (n) => `记下了 ${n} 条记忆`,
+  todos: () => "更新了待办",
+  external: (n) => `调用了 ${n} 次外部工具`,
+  other: (n) => `调用了 ${n} 个工具`,
+};
+
+/** 一组相邻工具调用的一行摘要：按类别首次出现的顺序合计，如"读取了 2 个文件，运行了 1 条命令"。 */
+export function summarizeTools(names: string[]): string {
+  const counts = new Map<ToolKind, number>();
+  for (const name of names) {
+    const { kind } = toolLabel(name, {});
+    counts.set(kind, (counts.get(kind) ?? 0) + 1);
+  }
+  return [...counts].map(([kind, count]) => SUMMARY[kind](count)).join("，");
+}
+
+// deepagents 在执行命令的输出后追加的状态行
+const EXIT_LINE = /\n?\[Command (?:succeeded|failed) with exit code (-?\d+)\]/g;
+
+/** 执行命令的输出：去掉 deepagents 追加的"[Command … with exit code N]"一行，取出退出码。 */
+export function parseExecuteOutput(output: string): { text: string; exitCode: number | null } {
+  const matches = [...output.matchAll(EXIT_LINE)];
+  const last = matches.at(-1);
+  if (!last || last.index === undefined) return { text: output, exitCode: null };
+  const text = output.slice(0, last.index) + output.slice(last.index + last[0].length);
+  return { text: text.replace(/^\n/, ""), exitCode: Number(last[1]) };
+}
