+import { describe, expect, it } from "vitest";
+import type { Thread } from "../../api/types";
+import { filterThreads, hasActiveThread, relativeTime, threadActivity } from "./activity";
+
+describe("会话状态点", () => {
+  it("运行中是蓝色呼吸点，待审批琥珀，出错红色", () => {
+    expect(threadActivity({ activity: "running" })).toEqual({
+      tone: "info",
+      label: "运行中",
+      pulse: true,
+    });
+    expect(threadActivity({ activity: "waiting" })).toEqual({
+      tone: "warning",
+      label: "待审批",
+      pulse: false,
+    });
+    expect(threadActivity({ activity: "failed" })).toEqual({
+      tone: "danger",
+      label: "出错",
+      pulse: false,
+    });
+  });
+
+  it("空闲、或接口没带这个字段：不显示", () => {
+    expect(threadActivity({ activity: null })).toBeNull();
+    expect(threadActivity({})).toBeNull();
+  });
+});
+
+describe("相对时间", () => {
+  const now = new Date(2026, 9, 22, 14, 30);
+  const at = (...parts: [number, number, number, number, number?]) =>
+    new Date(...parts).toISOString();
+
+  it("今天显示时分", () => {
+    expect(relativeTime(at(2026, 9, 22, 9, 5), now)).toBe("09:05");
+  });
+
+  it("昨天", () => {
+    expect(relativeTime(at(2026, 9, 21, 23, 59), now)).toBe("昨天");
+    // 跨年的昨天也是"昨天"
+    expect(relativeTime(at(2025, 11, 31, 22), new Date(2026, 0, 1, 10))).toBe("昨天");
+  });
+
+  it("今年更早显示月日，往年显示年月日", () => {
+    expect(relativeTime(at(2026, 0, 3, 8), now)).toBe("1月3日");
+    expect(relativeTime(at(2025, 11, 31, 8), now)).toBe("2025/12/31");
+  });
+
+  it("看不懂的时间不显示", () => {
+    expect(relativeTime("not a date", now)).toBe("");
+  });
+});
+
+describe("按标题搜索会话", () => {
+  const list = [{ title: "分析 Sales 表" }, { title: "读书笔记" }, { title: "" }];
+
+  it("空查询原样返回", () => {
+    expect(filterThreads(list, "  ")).toBe(list);
+  });
+
+  it("不分大小写，去掉首尾空白", () => {
+    expect(filterThreads(list, " sales ")).toEqual([list[0]]);
+  });
+
+  it("没有标题的会话按显示出来的“新会话”匹配", () => {
+    expect(filterThreads(list, "新会话")).toEqual([list[2]]);
+  });
+});
+
+describe("会话列表要不要定时刷新", () => {
+  const threads = (...activity: Thread["activity"][]) =>
+    activity.map((value) => ({ activity: value })) as Thread[];
+
+  it("有会话在跑或在等审批时才刷新", () => {
+    expect(hasActiveThread(undefined)).toBe(false);
+    expect(hasActiveThread(threads(null, "failed"))).toBe(false);
+    expect(hasActiveThread(threads(null, "waiting"))).toBe(true);
+    expect(hasActiveThread(threads("running"))).toBe(true);
+  });
+});
diff -ruN -x schema.d.ts -x openapi.json -x __pycache__ frontend/src/features/threads/activity.ts frontend/src/features/threads/activity.ts
--- frontend/src/features/threads/activity.ts	1970-01-01 08:00:00
+++ frontend/src/features/threads/activity.ts	2026-10-22 20:10:46
@@ -0,0 +1,53 @@
+import type { Thread } from "../../api/types";
+
+export interface ThreadActivityView {
+  tone: "info" | "warning" | "danger";
+  label: "运行中" | "待审批" | "出错";
+  pulse: boolean;
+}
+
+const VIEWS: Record<NonNullable<Thread["activity"]>, ThreadActivityView> = {
+  running: { tone: "info", label: "运行中", pulse: true },
+  waiting: { tone: "warning", label: "待审批", pulse: false },
+  failed: { tone: "danger", label: "出错", pulse: false },
+};
+
+/** 会话列表的状态点（设计 2026-10-22 3.1）；空闲时不显示。 */
+export function threadActivity(thread: Pick<Thread, "activity">): ThreadActivityView | null {
+  return thread.activity ? VIEWS[thread.activity] : null;
+}
+
+/** 有会话在跑或在等审批：会话列表要定时刷新，状态点才会跟着变。 */
+export function hasActiveThread(threads?: Pick<Thread, "activity">[]): boolean {
+  return (threads ?? []).some(
+    (thread) => thread.activity === "running" || thread.activity === "waiting",
+  );
+}
+
+const sameDay = (a: Date, b: Date) =>
+  a.getFullYear() === b.getFullYear() &&
+  a.getMonth() === b.getMonth() &&
+  a.getDate() === b.getDate();
+
+/** 会话列表右侧的时间：今天 HH:MM、昨天、今年 M月D日、更早 YYYY/M/D（按本机时区）。 */
+export function relativeTime(iso: string, now: Date): string {
+  const time = new Date(iso);
+  if (Number.isNaN(time.getTime())) return "";
+  if (sameDay(time, now)) {
+    const pad = (value: number) => String(value).padStart(2, "0");
+    return `${pad(time.getHours())}:${pad(time.getMinutes())}`;
+  }
+  const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
+  if (sameDay(time, yesterday)) return "昨天";
+  if (time.getFullYear() === now.getFullYear()) {
+    return `${time.getMonth() + 1}月${time.getDate()}日`;
+  }
+  return `${time.getFullYear()}/${time.getMonth() + 1}/${time.getDate()}`;
+}
+
+/** 按标题过滤（不分大小写）；没有标题的会话按显示出来的"新会话"匹配。空查询原样返回。 */
+export function filterThreads<T extends { title: string }>(threads: T[], query: string): T[] {
+  const needle = query.trim().toLowerCase();
+  if (!needle) return threads;
+  return threads.filter((thread) => (thread.title || "新会话").toLowerCase().includes(needle));
+}
