+++ frontend/src/components/chat/errorCard.tsx	2026-10-22 20:35:00
@@ -0,0 +1,97 @@
+import { useAuiState } from "@assistant-ui/react";
+import { ChevronDown, Copy, RotateCcw, TriangleAlert } from "lucide-react";
+import { useContext, useEffect, useRef, useState } from "react";
+import { isQuotaError } from "../../features/chat/retry";
+import { Button } from "../ui/Button";
+import { useCopy } from "../useCopy";
+import { RetryActionsContext } from "./retryActions";
+
+/** "换个模型再试"：列出其他对话模型，选一个就改会话的模型并重发这一句。 */
+function RetryWithModel({ models, onPick }: { models: string[]; onPick: (model: string) => void }) {
+  const [open, setOpen] = useState(false);
+  const box = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (!open) return;
+    const closeOutside = (event: MouseEvent) => {
+      if (!box.current?.contains(event.target as Node)) setOpen(false);
+    };
+    document.addEventListener("mousedown", closeOutside);
+    return () => document.removeEventListener("mousedown", closeOutside);
+  }, [open]);
+  return (
+    <div
+      ref={box}
+      className="relative"
+      onKeyDown={(event) => {
+        if (event.key === "Escape") setOpen(false);
+      }}
+    >
+      <Button aria-haspopup="menu" aria-expanded={open} onClick={() => setOpen(!open)}>
+        换个模型再试
+        <ChevronDown aria-hidden="true" className="size-3.5" />
+      </Button>
+      {open && (
+        <div
+          role="menu"
+          aria-label="选择模型"
+          className="absolute bottom-full left-0 z-20 mb-1 max-h-64 min-w-56 overflow-y-auto rounded-lg border border-border bg-card p-1 shadow-lg"
+        >
+          {models.map((model) => (
+            <button
+              key={model}
+              type="button"
+              role="menuitem"
+              className="block w-full truncate rounded-md px-2.5 py-1.5 text-left font-mono text-[13px] hover:bg-muted"
+              onClick={() => {
+                setOpen(false);
+                onPick(model);
+              }}
+            >
+              {model}
+            </button>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/**
+ * 运行失败的报错卡片（设计 2026-10-22 3.8）：标题是报错原文；最后一轮出错时可以"重试这一句"、
+ * "换个模型再试"（额度用完时重试没用，不给"重试这一句"）；总能"复制详情"。
+ */
+export function ErrorCard() {
+  const error = useAuiState(({ message }) =>
+    message.status?.type === "incomplete" && message.status.reason === "error"
+      ? String(message.status.error ?? "运行失败")
+      : null,
+  );
+  const isLast = useAuiState(({ message }) => message.isLast);
+  const actions = useContext(RetryActionsContext);
+  const { state: copyState, copy } = useCopy();
+  if (error === null) return null;
+  const quota = isQuotaError(error);
+  return (
+    <div className="mt-2 rounded-xl border border-danger bg-danger-soft p-3.5 text-sm">
+      <p className="flex items-start gap-2 text-foreground">
+        <TriangleAlert aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-danger" />
+        <span className="min-w-0 break-words whitespace-pre-wrap">{error}</span>
+      </p>
+      <div className="mt-3 flex flex-wrap items-center gap-2">
+        {isLast && !quota && (
+          <Button onClick={actions.retry}>
+            <RotateCcw aria-hidden="true" className="size-3.5" />
+            重试这一句
+          </Button>
+        )}
+        {isLast && actions.models.length > 0 && (
+          <RetryWithModel models={actions.models} onPick={actions.retryWith} />
+        )}
+        <Button variant="ghost" onClick={() => copy(error)}>
+          <Copy aria-hidden="true" className="size-3.5" />
+          {copyState === "copied" ? "已复制" : copyState === "failed" ? "复制失败" : "复制详情"}
+        </Button>
+      </div>
+    </div>
+  );
+}
