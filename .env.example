# 复制为 .env 后填写；.env 不进版本库。没有 .env 时 make 与 compose 都照样能跑，各项取默认值（R47）。

# ---- 宿主机上运行的工具（测试、迁移、本机调试）使用的地址；容器内地址由 compose 覆盖。下面两项就是默认值 ----
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent
LITELLM_BASE_URL=http://127.0.0.1:4000
# ---- 本地网关的两个密钥：都有默认值，可以不写（网关只绑本机）----
# 管理密钥：也是网关后台 http://127.0.0.1:4000/ui 的登录密码，默认 sk-open-personal-agent-local；
# 自己设的话以 sk- 开头
# LITELLM_MASTER_KEY=
# 加密存进网关数据库的模型参数（模型页新增的模型，D21）：要自己设，必须在第一次加模型之前；
# 一旦用上（不管默认值还是自己设的）就不能改，改了这些模型就读不出来，恢复备份时也要用同一个值
# LITELLM_SALT_KEY=
# LiteLLM 启动时不去 GitHub 拉价格表（当前网络不通会卡住）
LITELLM_LOCAL_MODEL_COST_MAP=True

# ---- 可选：共享文件夹。智能体通过 MCP 的 files 服务读写它（写入、修改、移动前会先问你）。----
# 默认是项目里的 .workdata/shared/；可改成本机任意文件夹的绝对路径，如 /Users/me/Documents/agent
# SHARED_DIR=

# ---- 后端的时区（日志、配置备份的文件名、命令里的 date）：按所在地填，不填就是 UTC ----
# 经 make 启动时以本机系统时区为准；直接用 compose 启动时用这里的值
HOST_TZ=Asia/Shanghai

# ---- 上游模型网关（公司 LiteLLM 网关；本地网关把模型请求转发给它）----
UPSTREAM_GATEWAY_URL=https://your-llm-gateway.example.com
UPSTREAM_GATEWAY_KEY=

# ---- 以后直连各厂商时再填（填好后到模型页新增用这个来源的模型）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---- 先行验证（make smoke）使用的模型版本 ----
SMOKE_CLAUDE_MODEL=claude-opus-4-6
SMOKE_ALT_MODEL=gemini-3.5-flash

# ---- 可选：覆盖设置页里的设置（D22）。名字是设置键把"."换成"__"再大写，如：----
# AGENT__DEFAULT_MODEL=claude-opus-4-6
# KNOWLEDGE__RECALL_TOP_K=5
# 写了的项在设置页上显示"环境变量"、不能在页面上改；改完执行 make restart
